# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Secrets and local config ----
.env
*.local
config/secrets.yaml

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Data: keep the folders, ignore their contents ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# Track only the sample manifest (essay ids + split), not the corpus text.
!data/processed/bawe_human_sample_manifest.csv

# ---- Model artefacts and checkpoints ----
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.gguf
checkpoints/
models/
wandb/
runs/
mlruns/
.cache/

# ---- Outputs: keep the folder, ignore generated artefacts ----
outputs/*
!outputs/.gitkeep

# ---- Generated slide decks (regenerate with make_deck.py) ----
dissertation/presentation/*.pptx

# ---- Generated meeting records (regenerate with pandoc from the .md) ----
dissertation/meetings/*.docx

# ---- Generated dissertation document (regenerate with dissertation/docgen) ----
dissertation/Dissertation_*.docx
dissertation/Dissertation_*.pdf
dissertation/docgen/node_modules/
# Generated paper draft (source is dissertation/aics_paper_draft.md)
dissertation/aics_paper_draft.docx

# ---- Private meeting recordings (audio/video, never commit) ----
Supervisor meetings recordings/

# ---- Logs ----
*.log
logs/

# ---- OS and editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Final demo data (embeds BAWE-derived essay text, never commit) ----
dissertation/presentation/final_demo/data.js
dissertation/presentation/final_demo/demo_sent_meta.json
