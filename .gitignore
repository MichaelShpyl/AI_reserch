# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Secrets and local config ----
.env
*.local
config/secrets.yaml

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Data: keep the folders, ignore their contents ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# Track only the sample manifest (essay ids + split), not the corpus text.
!data/processed/bawe_human_sample_manifest.csv

# ---- Model artefacts and checkpoints ----
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.gguf
checkpoints/
models/
wandb/
runs/
mlruns/
.cache/

# ---- Outputs ----
# Ignored by default: checkpoints, training logs, unpacked Word templates, scratch renders.
# Two exceptions, so a reader can check the write-up against the actual numbers:
#   1. the top-level results JSON, which is what every figure in the dissertation is read from;
#   2. the two example guides built from the AI-written essay.
# The human-essay guide stays out. It reproduces BAWE prose and that licence does not allow
# redistribution, so 3108a_human_* is deliberately absent rather than forgotten.
outputs/*
!outputs/.gitkeep
!outputs/*.json
!outputs/verification_guides/
outputs/verification_guides/*
!outputs/verification_guides/3108a_ai*

# ---- Generated slide decks (regenerate with make_deck.py) ----
dissertation/presentation/*.pptx

# ---- Generated meeting records (regenerate with pandoc from the .md) ----
dissertation/meetings/*.docx

# ---- Generated dissertation document (regenerate with dissertation/docgen) ----
dissertation/Dissertation_*.docx
dissertation/Dissertation_*.pdf
dissertation/docgen/node_modules/
# Generated paper draft (source is dissertation/aics_paper_draft.md)
dissertation/aics_paper_draft.docx

# ---- Private meeting recordings (audio/video, never commit) ----
Supervisor meetings recordings/

# ---- Logs ----
*.log
logs/

# ---- OS and editors ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Final demo data (embeds BAWE-derived essay text, never commit) ----
dissertation/presentation/final_demo/data.js
dissertation/presentation/final_demo/demo_sent_meta.json

# ---- Personal talk guides / cribs (never published; kept local only) ----
dissertation/presentation/*TalkGuide.md
dissertation/presentation/PreFinal_TalkTrack.md

# ---- Web app example texts: the human one is BAWE-derived, never publish it ----
src/webapp/static/example_human.txt

# ---- Editor / harness scratch ----
.claude/
# Throwaway Chrome profiles the screenshot script creates
dissertation/presentation/.chrome_*/
