# Commercial backend (Backend A) API keys for the commercial-vs-local comparison.
# Copy this file to .env and fill in ONE provider. .env is gitignored, so keys are never committed.
#
# Free-tier route (recommended first): Google Gemini.
#   Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Self-funded routes (small, capped spend) if the free tier is not enough:
#   Anthropic Claude:  https://console.anthropic.com/  (needs: pip install anthropic)
ANTHROPIC_API_KEY=
#   OpenAI GPT:        https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Then run, for example:
#   python src/question_gen/generate_questions.py --backend commercial --provider gemini --id 3108a
#   python src/evaluation/compare_backends.py --id 3108a --source ai --commercial gemini
